diff --git a/openscope-v6.28.0-ws/src/assets/scripts/client/WebSockets.js b/openscope-v6.28.0-ws/src/assets/scripts/client/WebSockets.js
new file mode 100644
index 0000000..ac19a5c
--- /dev/null
+++ b/openscope-v6.28.0-ws/src/assets/scripts/client/WebSockets.js
@@ -0,0 +1,153 @@
+import { io } from 'socket.io-client';
+
+import App from "./App";
+import AirportController from './airport/AirportController';
+import GameController from './game/GameController';
+import TimeKeeper from './engine/TimeKeeper';
+
+
+/**/
+function sleep(milliseconds) {
+    const start = Date.now();
+    while (Date.now() - start < milliseconds) {
+        // Do nothing, just wait
+    }
+}
+/**/
+
+export default class WebSockets {
+
+    constructor(port, uid, _app) {
+        this.ws_url = `ws://localhost:${port}/`;
+        this.uid = uid;
+
+        /**
+         *
+         * @type {App}
+         */
+        this._app = _app;
+
+        return this;
+    }
+
+    init() {
+        this._init_socket();
+    }
+
+    _init_socket() {
+        const socket = io(this.ws_url);
+
+        const uid = this.uid;
+
+        const processCommand_fn = this._app._appController.inputController.processCommand.bind(this._app._appController.inputController);
+        const webhook_aircraft_fn = this._app._appController._webhook_aircraft.bind(this._app._appController);
+        const webhook_info_fn = this._app._appController._webhook_info.bind(this._app._appController);
+
+        const update_fn = this._app.updateTime.bind(this._app);
+
+        socket.on('connect', function () {
+            const _json = {
+                'uid': uid,
+                'is_ctl': false,
+            };
+
+            console.log("join", _json);
+            socket.emit('join', _json);
+        });
+
+        socket.on('reset', function (data) {
+            console.log("reset", data);
+
+            if (typeof callback === "function") {
+                callback('ACK');
+            }
+
+            const uuid = data.uuid;
+            const icao = data.icao;
+
+            AirportController.airport_set(icao);
+            GameController.game_reset_score_and_events();
+            TimeKeeper.reset();
+
+            sleep(1000); // wait for 1000ms
+
+            const _json = {
+                'uid': uid,
+                'uuid': uuid,
+                'state': webhook_aircraft_fn(),
+                //
+                'timestamp': TimeKeeper._fake_gameTimeSeconds,
+            };
+
+            console.log("reset_res", _json);
+            socket.emit('reset_res', _json);
+        });
+
+        socket.on('action', function (data) {
+            console.log("action", data);
+
+            if (typeof callback === "function") {
+                callback('ACK');
+            }
+
+            const uuid = data.uuid;
+            const actions = data.actions;
+
+            /**/
+            const act_len = Array.isArray(actions) ? actions.length : -1;
+
+            if (Array.isArray(actions)) {
+                actions.forEach(_action => {
+                    processCommand_fn(_action);
+                });
+            } else {
+                processCommand_fn(actions);
+            }
+            /**/
+
+            // processCommand_fn(action);
+
+            const _json = {
+                'uid': uid,
+                'uuid': uuid,
+                'act_len': act_len,
+            };
+
+            console.log("action_res", _json);
+            socket.emit('action_res', _json);
+        });
+
+        socket.on('step', function (data, callback) {
+            console.log("step", data);
+
+            if (typeof callback === "function") {
+                callback('ACK');
+            }
+
+            const uuid = data.uuid;
+            const step_size = data.step_size;
+
+            for (let i = 0; i < step_size; i++) {
+                update_fn();
+            }
+
+            const reward = GameController.get_last_step_reward();
+
+            const _json = {
+                'uid': uid,
+                'uuid': uuid,
+                'state': webhook_aircraft_fn(),
+                'reward': reward,
+                'done': 1, // if is done then return 0, else return 1
+                'info': webhook_info_fn(),
+                //
+                'timestamp': TimeKeeper._fake_gameTimeSeconds,
+            };
+
+            console.log("step_res", _json);
+            socket.emit('step_res', _json);
+        });
+
+        this.socket = socket;
+    }
+}
